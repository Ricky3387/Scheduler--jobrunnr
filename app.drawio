<mxfile host="app.diagrams.net">
  <diagram name="High Scale Streaming Report Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Client -->
        <mxCell id="client" value="Client (UI)" style="rounded=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- Load Balancer -->
        <mxCell id="lb" value="Load Balancer" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="180" y="300" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="gateway" value="API Gateway" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- Orchestrator Pods -->
        <mxCell id="orch1" value="Orchestrator Pod 1" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="520" y="220" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="orch2" value="Orchestrator Pod 2" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="520" y="300" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="orch3" value="Orchestrator Pod N" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Redis -->
        <mxCell id="redis" value="Redis (Cache + Status)" style="rounded=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="720" y="260" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- DB -->
        <mxCell id="db" value="PostgreSQL (Metadata)" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="720" y="340" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Kafka -->
        <mxCell id="kafka" value="Kafka (Event Bus)" style="rounded=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="940" y="300" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Report Pods -->
        <mxCell id="report1" value="Report Pod 1" style="rounded=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="1160" y="220" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="report2" value="Report Pod 2" style="rounded=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="1160" y="300" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="report3" value="Report Pod N" style="rounded=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="1160" y="380" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Storage -->
        <mxCell id="storage" value="Object Storage (S3/GCS)" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="1360" y="300" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Notification -->
        <mxCell id="notify" value="Notification Service" style="rounded=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="1360" y="380" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Connections -->
        <mxCell edge="1" parent="1" source="client" target="lb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="lb" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell edge="1" parent="1" source="gateway" target="orch1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="gateway" target="orch2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="gateway" target="orch3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell edge="1" parent="1" source="orch1" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="orch2" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="orch3" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell edge="1" parent="1" source="orch1" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="orch2" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="orch3" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell edge="1" parent="1" source="orch1" target="kafka"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="orch2" target="kafka"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="orch3" target="kafka"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell edge="1" parent="1" source="kafka" target="report1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="kafka" target="report2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="kafka" target="report3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell edge="1" parent="1" source="report1" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="report2" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="report3" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell edge="1" parent="1" source="storage" target="notify"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
